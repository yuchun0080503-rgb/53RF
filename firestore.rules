rules_version = '2';

// 資料結構（對應 src/permissions.mjs 的角色矩陣，兩邊務必保持一致）：
// users/{uid}
// projects/{projectId}
//   memberUids: array<uid>              ← 給「我的研究」列表做 array-contains 查詢用
//   ownerUid, name, course, teacherReq, dueDate, field, reportType, reportUrl, createdAt
//   aiLevel: 0–3                        ← 老師設定的 AI 權限；只有老師能改，而且老師只能改這一個欄位
//   courseId, courseCode, teacherUid    ← 用課程代碼建立／加入課程的研究才有；建立後不能改（老師也因此自動成為成員）
//   assignmentId, assignmentTitle       ← 課程有多個作業時屬於哪一個；Owner 之後可以改選
// courses/{courseId}     { name, teacherUid, teacherName, teacherReq, dueDate, defaultAiLevel, code, codeExpires }
// courseCodes/{code}     { courseId, teacherUid, active, expiresAt }   學生用代碼查課程；過期或停用後不能再用來加入
//   members/{uid}        { role, task, displayName, email, color, joinedAt }   role: owner|editor|viewer|teacher
//   invites/{token}       { role, email, task, createdAt, status, redeemedBy }
//   objects/{objectId}    Canvas Object（第六章欄位）
//   researchState/current { json, updatedBy, updatedAt }   小組共用的 Agent 流程狀態（含 Evidence Map）
//   researchState/canvas  { ver }                          共用的 Canvas 版本號
//   agentTrace/{traceId}  { w, x, k, uid, at }             k: user|sync|ai|sys；只能新增，不能修改或刪除
//   feedback/{id}         { text, uid, by, at }   老師給小組的回饋；只有老師能寫，組員都看得到
//   tasks/{taskId}        { title, type, assigneeUid, createdBy, createdAt, done, doneBy, doneAt }   分工清單；done 只有負責人本人能改
//
// 這個系統只用 Firebase 免費方案，沒有 Cloud Functions：所有「硬限制」都寫在這份規則裡，
// 由 Firestore 伺服器強制執行，前端程式被改掉也繞不過去。

service cloud.firestore {
  match /databases/{database}/documents {

    // 這些函式用到 get()／exists() 與 {database}，必須定義在這個 match 區塊裡面才有作用
    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function roleOf(projectId) {
      return memberDoc(projectId).data.role;
    }

    function isMember(projectId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid));
    }

    function hasRole(projectId, roles) {
      return isMember(projectId) && roleOf(projectId) in roles;
    }

    // 四種角色都能讀；老師是唯讀。
    function canRead(projectId) {
      return hasRole(projectId, ['owner', 'editor', 'viewer', 'teacher']);
    }

    // Owner 正在刪除這份研究（project.deleting == true）：這時才允許刪掉平常不能刪的東西（研究歷程、老師的成員文件）
    function ownerDeleting(projectId) {
      return hasRole(projectId, ['owner'])
        && get(/databases/$(database)/documents/projects/$(projectId)).data.get('deleting', false) == true;
    }

    function canWrite(projectId) {
      return hasRole(projectId, ['owner', 'editor']);
    }

    // 課程代碼現在可以用來加入這門課：代碼屬於這門課與這位老師、沒有被停用、還沒過期（用伺服器時間判斷）
    function codeOk(code, courseId, teacherUid) {
      let c = get(/databases/$(database)/documents/courseCodes/$(code)).data;
      return c.courseId == courseId && c.teacherUid == teacherUid && c.active == true && request.time < c.expiresAt;
    }

    // ---- courses：老師建立的課程。任何登入者都能用 id 讀單一課程（學生輸入代碼後要看到課名與老師要求）；列表只列自己開的 ----
    match /courses/{courseId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.defaultAiLevel in [0, 1, 2, 3];
      allow update: if isSignedIn()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.defaultAiLevel in [0, 1, 2, 3];
      allow delete: if false;
    }

    // ---- 課程的組別清單：學生輸入代碼後看得到各組並直接加入。只記組名與對應的研究，不含研究內容 ----
    //      登記的人必須是那份研究的 Owner，而且研究屬於這門課；同一個組別 id 只能登記一次（老師預先開的組別不會被搶兩次）
    match /courses/{courseId}/groups/{gid} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.courseId == courseId;
      allow update: if false;
      allow delete: if isSignedIn() && (
        get(/databases/$(database)/documents/courses/$(courseId)).data.teacherUid == request.auth.uid
        || resource.data.createdBy == request.auth.uid);
    }

    // ---- courseCodes：代碼就是文件 id。只能一筆一筆查（不能列出全部代碼）；已存在的代碼別人不能蓋掉（等於撞號會被拒絕） ----
    match /courseCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && code.size() == 6
        && request.resource.data.teacherUid == request.auth.uid
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.teacherUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.expiresAt is timestamp;
      allow update: if isSignedIn()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'expiresAt']);
      allow delete: if false;
    }

    // ---- users ----
    match /users/{uid} {
      // 只能讀自己的個人檔案（組員的名字與顏色是從各專案的 member 文件讀，網站本來就不需要讀別人的 users 文件）
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /projects/{projectId} {

      // 讀取整份 project 文件（名稱、截止日等）
      allow get: if canRead(projectId);

      // 「我的研究」列表查詢：只允許查自己是成員的那些 project
      allow list: if isSignedIn() && resource.data.memberUids.hasAny([request.auth.uid]);

      // 建立新專案：建立者必須把自己列為 owner 且加進 memberUids；AI 權限只能是預設值 2，不能自己開到 3
      // 輸入課程代碼建立：代碼要有效，memberUids 是自己＋那門課的老師，AI 權限照課程的預設值
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && (
          (
            request.resource.data.memberUids == [request.auth.uid]
            && request.resource.data.aiLevel == 2
            && !('teacherUid' in request.resource.data) && !('courseId' in request.resource.data)
          )
          || (
            request.resource.data.teacherUid != request.auth.uid
            && request.resource.data.memberUids == [request.auth.uid, request.resource.data.teacherUid]
            && codeOk(request.resource.data.courseCode, request.resource.data.courseId, request.resource.data.teacherUid)
            && request.resource.data.aiLevel == get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.defaultAiLevel
          )
        );

      // 專案設定（名稱、課程、截止日…）只有 owner 能改，但 aiLevel 連 owner 也不能改；
      // aiLevel 只有老師能改，而且老師只能改這一個欄位、值必須是 0–3；
      // 例外：memberUids 欄位允許「本人透過合法邀請加入自己」這個特例（見下方 invites 的 redeemInvite 流程）
      allow update: if (
          hasRole(projectId, ['owner'])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aiLevel', 'ownerUid', 'teacherUid', 'courseId', 'courseCode'])
          // 一旦標成刪除中就不能反悔：否則 Owner 可以「標記 → 清掉研究歷程 → 取消標記」來規避歷程不可刪除的限制
          && !(resource.data.get('deleting', false) == true && request.resource.data.get('deleting', false) != true)
        )
        // 已建立的研究之後才輸入代碼加入課程：只能加入一次，老師一併加進 memberUids
        || (
          hasRole(projectId, ['owner'])
          && resource.data.get('courseId', '') == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['courseId', 'courseCode', 'teacherUid', 'memberUids', 'course', 'assignmentId', 'assignmentTitle'])
          && request.resource.data.teacherUid != request.auth.uid
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.resource.data.teacherUid])
          && codeOk(request.resource.data.courseCode, request.resource.data.courseId, request.resource.data.teacherUid)
        )
        || (
          hasRole(projectId, ['teacher'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiLevel'])
          && request.resource.data.aiLevel in [0, 1, 2, 3]
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid))
        );

      allow delete: if hasRole(projectId, ['owner']);

      // ---- members ----
      match /members/{memberUid} {
        allow read: if canRead(projectId);

        // 新增成員：owner 建立自己的 owner 文件（建立專案時），或是本人憑有效邀請自行加入（角色只能是邀請上寫的角色）
        allow create: if (
            isSignedIn() && request.auth.uid == memberUid && request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
          )
          // 輸入課程代碼後直接加入課程裡的某一組：角色只能是 editor，而且要帶這門課目前有效的代碼
          || (
            isSignedIn() && request.auth.uid == memberUid && request.resource.data.role == 'editor'
            && get(/databases/$(database)/documents/projects/$(projectId)).data.get('courseId', '') != ''
            && codeOk(request.resource.data.joinCode, get(/databases/$(database)/documents/projects/$(projectId)).data.courseId, get(/databases/$(database)/documents/projects/$(projectId)).data.teacherUid)
          )
          // 課程的老師：由 Owner 寫入，而且只能是 project.teacherUid 那一位（建立或加入課程時已經用代碼驗證過）
          || (
            isSignedIn() && request.resource.data.role == 'teacher'
            && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerUid == request.auth.uid
            && get(/databases/$(database)/documents/projects/$(projectId)).data.get('teacherUid', '') == memberUid
          )
          || (
            isSignedIn() && request.auth.uid == memberUid
            && exists(/databases/$(database)/documents/projects/$(projectId)/invites/$(request.resource.data.inviteToken))
            && get(/databases/$(database)/documents/projects/$(projectId)/invites/$(request.resource.data.inviteToken)).data.status == 'pending'
            && get(/databases/$(database)/documents/projects/$(projectId)/invites/$(request.resource.data.inviteToken)).data.role == request.resource.data.role
          );

        // 改角色／負責內容：只有 owner；不能把自己（唯一 owner）降級、不能把人改成老師、也不能動老師的文件。
        // 另外允許本人更新自己的顯示名稱／頭像顏色（不含 role）。
        allow update: if (
            hasRole(projectId, ['owner'])
            && resource.data.role != 'teacher'
            && request.resource.data.role in ['owner', 'editor', 'viewer']
            && !(memberUid == request.auth.uid && request.resource.data.role != 'owner')
          )
          || (
            isSignedIn() && request.auth.uid == memberUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'color'])
          );

        // 移除成員：owner 可以移除老師以外的其他人
        allow delete: if (hasRole(projectId, ['owner']) && memberUid != request.auth.uid && resource.data.role != 'teacher')
          // 刪除整份研究時：Owner 可以移除所有其他成員（含老師）
          || (ownerDeleting(projectId) && memberUid != request.auth.uid)
          // 研究已經被刪掉之後，任何人都可以清掉自己留下的成員文件
          || (isSignedIn() && request.auth.uid == memberUid
              && !exists(/databases/$(database)/documents/projects/$(projectId)));
      }

      // ---- invites：只有 owner 能開邀請；任何已登入使用者可以讀「單一」邀請文件以兌換（用 token 當 doc id，等同隨機碼） ----
      match /invites/{token} {
        allow get: if isSignedIn();
        allow list: if hasRole(projectId, ['owner']);
        allow create: if hasRole(projectId, ['owner'])
          && request.resource.data.role in ['editor', 'viewer', 'teacher']
          && request.resource.data.status == 'pending';
        allow update: if isSignedIn()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'redeemed'
          && request.resource.data.redeemedBy == request.auth.uid
          && request.resource.data.role == resource.data.role;
        allow delete: if hasRole(projectId, ['owner']);
      }

      // ---- canvas objects：第六章 Canvas Object 結構 ----
      match /objects/{objectId} {
        allow read: if canRead(projectId);
        allow create, update: if canWrite(projectId)
          && request.resource.data.lastEditedBy == request.auth.uid;
        allow delete: if canWrite(projectId);
      }

      // ---- research state：小組共用的 Agent 流程狀態與 Canvas 版本號，owner／editor 可寫 ----
      match /researchState/{docId} {
        allow read: if canRead(projectId);
        allow write: if canWrite(projectId) && docId in ['current', 'canvas'];
        allow delete: if ownerDeleting(projectId);
      }

      // ---- tasks：分工清單。owner／editor 可以新增任務；「完成」只能由負責人本人標記，而且一定要記下是誰、什麼時候標的
      //      （時間必須是伺服器時間，不能自己填）。老師與 viewer 只能看。任務內容建立後不能改，要改就刪掉重建 ----
      match /tasks/{taskId} {
        allow read: if canRead(projectId);
        allow create: if canWrite(projectId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.done == false
          && request.resource.data.type in ['research', 'data', 'present', 'poster', 'other']
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120;
        allow update: if canWrite(projectId) && (
            (
              resource.data.assigneeUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneBy', 'doneAt'])
              && request.resource.data.done is bool
              && request.resource.data.doneBy == request.auth.uid
              && request.resource.data.doneAt == request.time
            )
            // 還沒有人負責的任務可以自己認領（只能填自己）
            || (
              resource.data.assigneeUid == ''
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigneeUid'])
              && request.resource.data.assigneeUid == request.auth.uid
            )
          );
        allow delete: if hasRole(projectId, ['owner'])
          || (canWrite(projectId) && resource.data.createdBy == request.auth.uid);
      }

      // ---- feedback：老師給小組的回饋。只有這份研究的老師能新增（時間用伺服器時間）；組員都看得到；不能修改，老師可以刪掉自己寫的 ----
      match /feedback/{fbId} {
        allow read: if canRead(projectId);
        allow create: if hasRole(projectId, ['teacher'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if (hasRole(projectId, ['teacher']) && resource.data.uid == request.auth.uid) || ownerDeleting(projectId);
      }

      // ---- agent trace：只能新增、不能改寫或刪除歷史紀錄；每一筆都必須帶自己的 uid（不能冒用別人的身分）。
      //      owner／editor 可以寫各種紀錄；老師只會寫「權限」類紀錄（調整 AI Level）；viewer 不能寫 ----
      match /agentTrace/{traceId} {
        allow read: if canRead(projectId);
        allow create: if request.resource.data.uid == request.auth.uid
          && (
            (canWrite(projectId) && request.resource.data.k in ['user', 'sync', 'ai', 'sys'])
            || (hasRole(projectId, ['teacher']) && request.resource.data.k == 'sys')
          );
        allow update: if false;
        // 研究歷程平常不能刪；只有 Owner 刪除整份研究時才會一起清掉
        allow delete: if ownerDeleting(projectId);
      }
    }
  }
}
