{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "functions/**",
      "firebase.json",
      "firestore.rules",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "**/*.test.mjs",
      "dev-server.mjs",
      "package.json",
      "package-lock.json",
      "README.md",
      "src/firebase-config.example.js",
      "src/permissions.mjs",
      "src/sync.mjs",
      "tools/**",
      ".git/**",
      "**/.git/**",
      ".firebase/**",
      "**/*.log",
      "setup/**",
      "**/*.bat",
      "**/*.command",
      "**/*.exe",
      "**/*.sh"
    ],
    "rewrites": [
      {
        "source": "/api/ai",
        "function": {
          "functionId": "ai",
          "region": "asia-east1"
        }
      },
      {
        "source": "/api/zhsearch",
        "function": {
          "functionId": "zhsearch",
          "region": "asia-east1"
        }
      },
      {
        "source": "/api/openalex",
        "function": {
          "functionId": "oaproxy",
          "region": "asia-east1"
        }
      },
      {
        "source": "/api/jstage",
        "function": {
          "functionId": "jstage",
          "region": "asia-east1"
        }
      },
      {
        "source": "/",
        "destination": "/researchflow.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.mjs",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/javascript; charset=utf-8"
          }
        ]
      },
      {
        "source": "**/*.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  }
}
